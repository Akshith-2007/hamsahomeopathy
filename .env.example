# Hamsa Homeopathy - server settings.
# On the server:  cp .env.example .env && nano .env && chmod 600 .env
# Never commit .env. Generate secrets with:  openssl rand -base64 48 | tr -d '\n/+=' ; echo

# --- Address --------------------------------------------------------------------------------------
# Leave DOMAIN empty for IP mode: plain HTTP on http://SERVER_IP, for TESTING ONLY, no real patient data.
# scripts/set_domain.sh example.com fills DOMAIN in and switches on HTTPS.
DOMAIN=
# This server's public IPv4 address (Hostinger hPanel > VPS > Overview).
SERVER_IP=
# Normally leave these unset: they are built from DOMAIN / SERVER_IP.
# DJANGO_ALLOWED_HOSTS=
# DJANGO_CSRF_TRUSTED_ORIGINS=

# --- Security -------------------------------------------------------------------------------------
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
# HTTPS hardening (secure cookies, HTTPS redirect, HSTS) turns on by itself in domain mode.
# HSTS: browsers remember it. Start at 1 hour; after a week without problems raise to 31536000 (1 year).
HSTS_SECONDS=3600
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=false
# Overrides, normally unset: DJANGO_SECURE_COOKIES, DJANGO_SSL_REDIRECT, DJANGO_BEHIND_TLS_PROXY

# --- Database (PostgreSQL in Docker) --------------------------------------------------------------
POSTGRES_DB=hamsa
POSTGRES_USER=hamsa
POSTGRES_PASSWORD=

# --- First administrator (created on start if missing; must pass the password rules) ------------
# After the first start, sign in, then blank DJANGO_ADMIN_PASSWORD here (it is never used again).
DJANGO_ADMIN_USERNAME=admin
DJANGO_ADMIN_PASSWORD=
DJANGO_ADMIN_EMAIL=

# --- Uploads --------------------------------------------------------------------------------------
# Stored on the "media" Docker volume. Per-file limit; nginx/Caddy allow 60 MB per request.
ATTACHMENT_MAX_UPLOAD_MB=10
ATTACHMENT_MAX_FILES=10
# Optional: private S3-compatible storage (Cloudflare R2, Backblaze B2, AWS) instead of the local volume.
# Leave S3_BUCKET_NAME empty to keep uploads on this server (default).
S3_BUCKET_NAME=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_ADDRESSING_STYLE=path
S3_URL_EXPIRE_SECONDS=300

# --- Backups (scripts/backup.sh) ------------------------------------------------------------------
# rclone remote for off-site copies, e.g. b2:hamsa-backups (set up with: sudo rclone config).
# Empty = local backups only (backup.sh warns).
BACKUP_RCLONE_REMOTE=

# --- Sign-in protection ---------------------------------------------------------------------------
MAX_FAILED_LOGINS=5
LOGIN_RATE_LIMIT=20
LOGIN_RATE_WINDOW_MINUTES=15
API_LOGIN_RATE=10/min
SESSION_COOKIE_AGE=28800

# --- App server and logging -----------------------------------------------------------------------
WEB_CONCURRENCY=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120
LOG_LEVEL=INFO
DJANGO_LOG_LEVEL=INFO

# --- Clinic ---------------------------------------------------------------------------------------
TIME_ZONE=Asia/Kolkata
CLINIC_NAME=Hamsa Homeopathy
CLINIC_ADDRESS=
CLINIC_PHONE=

# Demo data: training only, NEVER on the live clinic.
SEED_DEMO_DATA=false
DEMO_PASSWORD=

# Notifications (the console backend only writes to the log)
NOTIFICATION_BACKEND=core.notifications.ConsoleBackend
SMS_ENABLED=false
WHATSAPP_ENABLED=false
