# Copy to .env and adjust. Never commit the real .env.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5000
# Set to true once the site is served over HTTPS.
DJANGO_SECURE_COOKIES=false
# DJANGO_BEHIND_TLS_PROXY=true

POSTGRES_DB=hamsa
POSTGRES_USER=hamsa
POSTGRES_PASSWORD=hamsa-dev-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

TIME_ZONE=Asia/Kolkata
CLINIC_NAME=Hamsa Homeopathy
CLINIC_ADDRESS=
CLINIC_PHONE=

# First run only: create demo users + sample patients.
SEED_DEMO_DATA=false
DEMO_PASSWORD=Hamsa@2026

# Notifications (future-ready; console backend just logs)
NOTIFICATION_BACKEND=core.notifications.ConsoleBackend
SMS_ENABLED=false
WHATSAPP_ENABLED=false
