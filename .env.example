# Copy to .env and adjust. Never commit the real .env (it is in .gitignore).
# Generate a key with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# true = also accept this PC's LAN IP/hostname (access from other devices on the same Wi-Fi)
DJANGO_ALLOW_LAN=false
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5000

# --- HTTPS (set all of these once the site is served over HTTPS) ---------------------------------
DJANGO_SECURE_COOKIES=false
DJANGO_BEHIND_TLS_PROXY=false
DJANGO_SSL_REDIRECT=false
# 31536000 = one year. Leave 0 until HTTPS is confirmed working: browsers remember HSTS.
DJANGO_HSTS_SECONDS=0
DJANGO_HSTS_INCLUDE_SUBDOMAINS=true
DJANGO_HSTS_PRELOAD=true

# --- Database: either DATABASE_URL or the POSTGRES_* values ----------------------------------------
# DATABASE_URL=postgres://user:password@host:5432/hamsa?sslmode=require
POSTGRES_DB=hamsa
POSTGRES_USER=hamsa
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- First administrator (created on start if missing; must pass the password rules) ---------------
DJANGO_ADMIN_USERNAME=admin
DJANGO_ADMIN_PASSWORD=
DJANGO_ADMIN_EMAIL=

# --- Uploads ------------------------------------------------------------------------------------
# Where uploads are stored on disk (Docker/K8s already use /app/media on a persistent volume).
# MEDIA_ROOT=/var/lib/hamsa/media
ATTACHMENT_MAX_UPLOAD_MB=10
ATTACHMENT_MAX_FILES=10
# Behind nginx (docker-compose.nginx.yml): let nginx stream protected files.
MEDIA_ACCEL_REDIRECT_PREFIX=
# S3-compatible object storage (leave S3_BUCKET_NAME empty to store uploads on local disk / volume).
S3_BUCKET_NAME=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_ADDRESSING_STYLE=path
S3_URL_EXPIRE_SECONDS=300

# --- Sign-in protection -------------------------------------------------------------------------
MAX_FAILED_LOGINS=5
LOGIN_RATE_LIMIT=20
LOGIN_RATE_WINDOW_MINUTES=15
API_LOGIN_RATE=10/min
SESSION_COOKIE_AGE=28800

# --- App server and logging ---------------------------------------------------------------------
WEB_CONCURRENCY=3
GUNICORN_TIMEOUT=120
LOG_LEVEL=INFO
DJANGO_LOG_LEVEL=INFO

TIME_ZONE=Asia/Kolkata
CLINIC_NAME=Hamsa Homeopathy
CLINIC_ADDRESS=
CLINIC_PHONE=

# Demo data (training/evaluation only, never on the live clinic): demo users + sample patients.
SEED_DEMO_DATA=false
DEMO_PASSWORD=

# Notifications (console backend just logs)
NOTIFICATION_BACKEND=core.notifications.ConsoleBackend
SMS_ENABLED=false
WHATSAPP_ENABLED=false
